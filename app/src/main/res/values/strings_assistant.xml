<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="assistant_title">Grok Assistant</string>
    <string name="assistant_intro">Your dictations from the Tesla go to Grok (xAI). Your Tesla reads the reply aloud. The conversation context for Grok stays in memory only briefly. Your dictations are additionally logged locally on the device (for diagnostics and re-delivery) and only ever leave it toward xAI.</string>

    <string name="assistant_consent_title">Consent</string>
    <string name="assistant_consent_desc">Mandatory before the first start — confirms that dictations (and, if location sharing is enabled, your GPS position) go to xAI.</string>
    <string name="assistant_consent_granted">Consent given — start enabled.</string>
    <string name="assistant_consent_not_granted">Not consented yet — start blocked.</string>

    <string name="assistant_location_title">Share location with Grok</string>
    <string name="assistant_location_desc">Lets Grok answer location-based questions (\"best restaurant nearby\"). When enabled, GPS coordinates are included in each xAI request — same trust boundary as your dictation. Off by default.</string>
    <string name="assistant_location_action">Grant permission</string>
    <string name="assistant_location_on">Location sharing on.</string>
    <string name="assistant_location_off">Location sharing off.</string>
    <string name="assistant_location_on_no_permission">On — but the location permission is missing.</string>
    <string name="assistant_location_background_title">In-car use needs \"Allow all the time\"</string>
    <string name="assistant_location_background_desc">Grok replies are processed in the background while you drive — Android only provides a location then if access is set to \"Allow all the time\". Choose it in the app settings under Permissions &gt; Location.</string>
    <string name="assistant_location_background_action">Open app settings</string>

    <string name="assistant_apikey_title">xAI API key</string>
    <string name="assistant_apikey_desc">Stored encrypted on the device and not included in backups.</string>
    <string name="assistant_apikey_active">Key active</string>
    <string name="assistant_apikey_none">No key</string>
    <string name="assistant_apikey_field_label">Enter new key</string>
    <string name="assistant_apikey_hide">Hide key</string>
    <string name="assistant_apikey_show">Show key</string>
    <string name="assistant_apikey_save">Save</string>
    <string name="assistant_apikey_remove">Remove</string>
    <string name="assistant_apikey_test">Test key</string>
    <string name="assistant_keytest_valid">Key valid</string>
    <string name="assistant_keytest_auth">Key rejected (auth error)</string>
    <string name="assistant_keytest_no_network">No network</string>
    <string name="assistant_keytest_timeout">Timeout</string>
    <string name="assistant_keytest_ratelimit">Rate limited — try again later</string>
    <string name="assistant_keytest_server">Server/config error</string>
    <string name="assistant_keytest_missing_key">No key configured</string>
    <string name="assistant_keytest_error">Test failed</string>

    <string name="assistant_selftest_title">Grok self-test</string>
    <string name="assistant_selftest_desc">Tests the whole chain without sitting in the car: API key, GPS position, Tesla account, and one real Grok turn that sends a navigation destination to your Tesla via the Fleet API. The car really receives the destination, and the run costs one xAI request.</string>
    <string name="assistant_selftest_destination_label">Test destination</string>
    <string name="assistant_selftest_start">Run self-test</string>
    <string name="assistant_selftest_running">running…</string>
    <string name="assistant_selftest_skipped">skipped</string>
    <string name="assistant_selftest_stage_key">1 · API key</string>
    <string name="assistant_selftest_stage_position">2 · GPS position</string>
    <string name="assistant_selftest_stage_tesla">3 · Tesla account</string>
    <string name="assistant_selftest_stage_nav">4 · Navigation via Grok</string>
    <string name="assistant_selftest_stage_echo">Position reached Grok</string>
    <string name="assistant_selftest_position_ok">Fresh fix available</string>
    <string name="assistant_selftest_position_foreground_only">Fix available — in the car \"Allow all the time\" is required</string>
    <string name="assistant_selftest_position_disabled">Location sharing is off</string>
    <string name="assistant_selftest_position_no_permission">Location permission missing</string>
    <string name="assistant_selftest_position_no_fix">No fresh fix (max. 15 min old)</string>
    <string name="assistant_selftest_position_detail">%1$s (±%2$d m)</string>
    <string name="assistant_selftest_tesla_ok">Account connected, vehicle selected</string>
    <string name="assistant_selftest_tesla_no_credentials">No Tesla account connected</string>
    <string name="assistant_selftest_tesla_no_vehicle">No vehicle selected</string>
    <string name="assistant_selftest_nav_ok">Destination sent to the car</string>
    <string name="assistant_selftest_nav_failed">Navigation failed</string>
    <string name="assistant_selftest_nav_wrong_address">Wrong destination sent</string>
    <string name="assistant_selftest_nav_not_called">Grok did not call the navigation tool</string>
    <string name="assistant_selftest_consent_missing">Consent missing — enable it at the top</string>
    <string name="assistant_selftest_echo_matched">Grok knows the position</string>
    <string name="assistant_selftest_echo_not_found">Position not found in the reply</string>
    <string name="assistant_selftest_echo_no_clause">System prompt is empty — the position clause is never appended</string>
    <string name="assistant_selftest_answer_label">Grok\'s reply: %1$s</string>

    <string name="assistant_websearch_title">Allow internet access (web search)</string>
    <string name="assistant_websearch_desc">Lets Grok look things up live on the web via xAI for current questions (weather, news, prices). Your dictated question then goes to xAI\'s search subsystem — the same xAI trust boundary as a normal reply. Costs can add up: xAI bills tokens plus each successful search, and one question can trigger several searches. Off by default.</string>
    <string name="assistant_websearch_on">Web search on.</string>
    <string name="assistant_websearch_off">Web search off.</string>

    <string name="assistant_xsearch_title">Allow X/Twitter search</string>
    <string name="assistant_xsearch_desc">Lets Grok pull live posts from X/Twitter — a social-media signal, good for current discussion or sentiment. For factual answers, prefer web search. Same xAI trust boundary; billed per successful search like web search. Off by default.</string>
    <string name="assistant_xsearch_on">X search on.</string>
    <string name="assistant_xsearch_off">X search off.</string>

    <string name="assistant_model_title">Model</string>
    <string name="assistant_model_desc">Default: grok-4.3. Only change it if xAI recommends a different model.</string>

    <string name="assistant_drivername_title">Your name (optional)</string>
    <string name="assistant_drivername_desc">Grok addresses you with it. Used for {driver} in the greeting and behavior. Leave blank for a neutral form of address.</string>

    <string name="assistant_voicealias_title">Additional name for voice control</string>
    <string name="assistant_voicealias_desc">Additional contact for addressing by voice (\'Text to …\'). Redirects to Grok — Grok still replies as \'Grok\'. Tesla\'s voice control recognizes a FIRST + LAST name most reliably. \'Off\' removes the extra contact; selecting or applying syncs straight to the Tesla.</string>
    <string name="assistant_voicealias_off">Off</string>
    <string name="assistant_voicealias_custom">Custom name</string>
    <string name="assistant_voicealias_custom_hint">e.g. Viktor Grok</string>
    <string name="assistant_voicealias_apply">Apply &amp; sync to Tesla</string>
    <string name="assistant_voicealias_applying">running…</string>

    <string name="assistant_welcome_title">Greeting</string>
    <string name="assistant_welcome_desc">The first sentence your Tesla reads aloud at the start. {driver} is replaced by your name.</string>

    <string name="assistant_behavior_title">Grok behavior</string>
    <string name="assistant_behavior_desc">Instructs Grok how it should reply. {driver} is replaced by your name. Keep it short — it goes into every request.</string>
    <string name="assistant_behavior_reset">Restore default</string>

    <string name="assistant_ttl_title">Discard history after</string>
    <string name="assistant_ttl_desc">After this many seconds without input, the conversation history is deleted.</string>
    <plurals name="assistant_ttl_value">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>

    <string name="assistant_maxtokens_title">Maximum reply length</string>
    <string name="assistant_maxtokens_desc">Upper limit per reply. 512 equals roughly 3–5 readable sentences.</string>
    <plurals name="assistant_maxtokens_value">
        <item quantity="one">%1$d token</item>
        <item quantity="other">%1$d tokens</item>
    </plurals>

    <string name="assistant_temperature_title">Creativity</string>
    <string name="assistant_temperature_desc">0 = strictly factual, 1.5 = very creative. Default 0.7.</string>

    <string name="assistant_rate_min_title">Request limit per minute</string>
    <string name="assistant_rate_min_desc">Maximum Grok requests per conversation within 60 seconds.</string>
    <string name="assistant_rate_hour_title">Request limit per hour</string>
    <string name="assistant_rate_hour_desc">Maximum Grok requests per conversation within 60 minutes.</string>

    <string name="assistant_start_title">Start conversation now</string>
    <string name="assistant_start_desc">Plays the greeting into the Tesla — handy for testing before driving.</string>
    <string name="assistant_start_action">Start chat</string>

